[
  {
    "context": "!Terminal && !(Editor && !(vim_mode == normal || vim_mode == visual))",
    "bindings": {
      "space": null,
      "space k r": "editor::RestartLanguageServer",
      "space g v": "git_panel::ToggleFocus",
      "space d v": "diagnostics::Deploy",
      "space p v": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space c": "project_panel::CollapseAllEntries",
      "space e": "project_panel::ExpandSelectedEntry",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space e m": "editor::ExpandMacroRecursively",
    },
  },
]
